# Axis Camera Uptime — environment configuration
# Copy this file to .env and edit values. .env is gitignored.

# --- Required ---------------------------------------------------------------

# development or production. The Windows NSSM service overrides this to
# production via AppEnvironmentExtra, regardless of what is set here.
NODE_ENV=development

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-secure-random-string

# Required when running in production. Startup throws if either is missing.
# In development they are optional; if unset, a random password is generated
# on first run and printed to the console.
DEFAULT_ADMIN_EMAIL=admin@local
DEFAULT_ADMIN_PASSWORD=change-me

# --- Optional ---------------------------------------------------------------

# TCP port to listen on. The server binds 0.0.0.0:$PORT.
PORT=5000

# SQLite database file path. A "sqlite:" prefix is accepted and stripped.
# Must match drizzle.config.ts so `npm run db:push` and the server agree.
DATABASE_URL=./data/camera-uptime.db

# Default admin profile name fields (only used when seeding the default user).
DEFAULT_ADMIN_FIRSTNAME=Admin
DEFAULT_ADMIN_LASTNAME=User

# HTTPS / TLS — if SSL_CERT_PATH and SSL_KEY_PATH both point at readable
# files, the server starts an HTTPS listener instead of HTTP and enables
# secure session cookies + HSTS. SSL_CA_PATH is optional for intermediates.
# SSL_CERT_PATH=/etc/ssl/camera-uptime.crt
# SSL_KEY_PATH=/etc/ssl/camera-uptime.key
# SSL_CA_PATH=/etc/ssl/ca-bundle.crt

# Camera monitor tuning.
# POLL_CONCURRENCY=25
# ANALYTICS_POLL_INTERVAL=1
# CAMERA_CA_PATH=/etc/ssl/camera-ca-bundle.crt

# --- Email --------------------------------------------------------------
# SendGrid credentials are configured at runtime from the Settings UI and
# stored encrypted in the database (app_settings table). There is no SMTP
# env var configuration.
